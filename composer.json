{
  "name": "arrilot/bitrix-migrations",
  "license": "MIT",
  "description": "Database migrations for Bitrix CMS",
  "keywords": [
    "bitrix",
    "migrations"
  ],
  "authors": [
    {
      "name": "Nekrasov Ilya",
      "email": "nekrasov.ilya90@gmail.com"
    }
  ],
  "homepage": "https://github.com/Arrilot/bitrix-migrations",
  "require": {
    "php": "^7.1 || ^8.0",
    "symfony/console": "^4 || ^5 || ^6 || ^7 || ^8"
  },
  "require-dev": {
    "phpunit/phpunit": "^9 || ^10 || ^11",
    "mockery/mockery": "^1",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Arrilot\\BitrixMigrations\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Arrilot\\Tests\\BitrixMigrations\\": "tests/"
    }
  },
  "scripts": {
    "test": ["phpstan", "phpunit"]
  }
}
